{
  "name": "Airflow Development Environment",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.10-bullseye",

  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },

  "containerEnv": {
    "AIRFLOW_HOME": "/home/vscode/airflow"
  },

  "postCreateCommand": "pip install --upgrade pip && pip install \"apache-airflow[celery]==2.10.5\" --constraint \"https://raw.githubusercontent.com/apache/airflow/constraints-2.10.5/constraints-3.10.txt\"",

  "portsAttributes": {
    "8080": {
      "label": "Airflow Webserver",
      "onAutoForward": "notify"
    }
  },

  "remoteUser": "vscode"
}
